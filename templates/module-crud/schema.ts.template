import { boolean, index, integer, pgTable, serial, text, uniqueIndex } from "drizzle-orm/pg-core";
import { auditUsers, softDelete, timestamps } from "@/server/db/schema";
import { sysDept, sysUser } from "@/server/db/schema";

export const sysExample = pgTable(
  "sys_example",
  {
    id: serial("id").primaryKey(),
    name: text("name").notNull(),
    code: text("code").notNull(),
    remark: text("remark"),
    status: integer("status").notNull().default(1),
    sort: integer("sort").notNull().default(0),
    deptId: integer("dept_id").references(() => sysDept.id, { onDelete: "set null" }),
    ownerId: integer("owner_id").references(() => sysUser.id, { onDelete: "set null" }),
    isSystem: boolean("is_system").notNull().default(false),
    ...timestamps,
    ...softDelete,
    ...auditUsers,
  },
  (table) => [
    uniqueIndex("sys_example_code_uidx").on(table.code),
    index("sys_example_status_idx").on(table.status),
    index("sys_example_dept_id_idx").on(table.deptId),
    index("sys_example_owner_id_idx").on(table.ownerId),
  ],
);
