import { z } from "zod";
import { createCrudRoutes } from "@/server/crud/create-crud-routes";
import { sysExample } from "@/server/db/schema";

const exampleSchema = z.object({
  name: z.string().min(1),
  code: z.string().min(1),
  remark: z.string().optional().nullable(),
  status: z.coerce.number().default(1),
  sort: z.coerce.number().default(0),
  deptId: z.coerce.number().optional().nullable(),
  ownerId: z.coerce.number().optional().nullable(),
});

export const exampleCrud = createCrudRoutes({
  basePath: "/example",
  table: sysExample,
  idColumn: sysExample.id,
  createSchema: exampleSchema,
  updateSchema: exampleSchema.partial(),
  permissions: { prefix: "system.example" },
  dataScope: {
    deptId: sysExample.deptId,
    ownerId: sysExample.ownerId,
  },
  list: {
    select: {
      id: sysExample.id,
      name: sysExample.name,
      code: sysExample.code,
      remark: sysExample.remark,
      status: sysExample.status,
      sort: sysExample.sort,
      deptId: sysExample.deptId,
      ownerId: sysExample.ownerId,
      createdAt: sysExample.createdAt,
    },
    searchable: { name: "like", code: "like", status: "=", deptId: "=", ownerId: "=" },
    quickSearchFields: ["name", "code"],
    sortableFields: ["id", "sort", "createdAt"],
    defaultSort: { field: "sort", order: "asc" },
  },
  hooks: {
    beforeUpdate: async (_ctx, _id, values) => {
      // Protect is_system records here when key fields, status, or destructive flags are involved.
      return values;
    },
    beforeDelete: async (_ctx, _id) => {
      // Reject deletion for referenced records or is_system records here.
    },
  },
});
