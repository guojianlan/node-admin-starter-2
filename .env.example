# PostgreSQL
DATABASE_URL=postgres://admin_base:admin_base@localhost:5432/admin_base
TEST_DATABASE_URL=postgres://admin_base:admin_base@localhost:5432/admin_base_test
DATABASE_POOL_SIZE=10

# API
# 同源部署时留空；前后端拆分部署时填写 API Origin，例如 https://api.example.com
NEXT_PUBLIC_API_BASE_URL=
# 邀请邮件等服务端生成链接使用；生产必须填写 HTTPS Origin。
ADMIN_BASE_PUBLIC_URL=http://localhost:3000

# Auth / encryption
# 生产环境必须改成随机长密钥；已保存的邮件和存储密钥依赖此值解密。
ADMIN_BASE_SECRET_KEY=change-me-admin-base-secret
ADMIN_BASE_ADMIN_PASSWORD=123456
ADMIN_BASE_TOKEN_TTL_DAYS=7
LOG_LEVEL=info

# AI orchestration
# legacy 为默认值；mastra 当前只迁移 general-assistant，其他 Agent 继续走 legacy。
ADMIN_BASE_AI_ORCHESTRATOR=legacy

# AI Worker queue governance
# A claimable Job that remains queued beyond this threshold is reported as degraded.
ADMIN_BASE_AI_WORKER_STALLED_AFTER_SECONDS=60
# Poll interval for `pnpm ai:worker:monitor`.
ADMIN_BASE_AI_WORKER_MONITOR_INTERVAL_SECONDS=30
# Optional generic JSON webhook. It receives degraded and recovered queue-health events.
ADMIN_BASE_AI_WORKER_ALERT_WEBHOOK_URL=
