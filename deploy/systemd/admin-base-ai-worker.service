[Unit]
Description=Admin Base AI Worker
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=admin-base
Group=admin-base
WorkingDirectory=/srv/admin-base
Environment=NODE_ENV=production
EnvironmentFile=/etc/admin-base/admin-base.env
ExecStart=/usr/bin/env pnpm ai:worker
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
