    "/system/password-reset/confirm": { "post": { "tags": ["auth"], "summary": "Confirm password reset", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" } } } },

    "/system/user": { "get": { "tags": ["system"], "summary": "User page query" }, "post": { "tags": ["system"], "summary": "Create user" } },
    "/system/user/{id}": { "put": { "tags": ["system"], "summary": "Update user" }, "delete": { "tags": ["system"], "summary": "Delete user" } },
    "/system/user/password": { "put": { "tags": ["system"], "summary": "Admin reset user password" } },
