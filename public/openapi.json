{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Base System API",
    "version": "1.0.0",
    "description": "Admin Base 后台框架系统模块 API。响应统一为 { success, msg, data }，分页统一为 { data, total, page, pageSize }。敏感字段只返回 hasPassword、hasSecretKey、hasClientSecret 等状态。"
  },
  "servers": [{ "url": "/api" }],
  "security": [{ "bearerAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "msg": { "type": "string" },
          "data": {}
        },
        "required": ["success", "msg"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "msg": { "type": "string" },
          "data": {}
        },
        "required": ["success", "msg"]
      },
      "PageResponse": {
        "type": "object",
        "properties": {
          "data": { "type": "array", "items": {} },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" }
        },
        "required": ["data", "total", "page", "pageSize"]
      },
      "RiskLevel": {
        "type": "string",
        "enum": ["low", "medium", "high", "critical"]
      },
      "DangerousFileStrategy": {
        "type": "string",
        "enum": ["reject", "isolated-download", "force-download"]
      }
    },
    "responses": {
      "OK": { "description": "OK" },
      "Unauthorized": { "description": "Unauthorized" },
      "Forbidden": { "description": "Forbidden" },
      "PasswordChangeRequired": { "description": "Password change required" }
    }
  },
  "tags": [
    { "name": "auth" },
    { "name": "system" },
    { "name": "settings" },
    { "name": "ai" },
    { "name": "oauth" },
    { "name": "profile" },
    { "name": "notice" },
    { "name": "file" },
    { "name": "audit" },
    { "name": "dashboard" },
    { "name": "doctor" }
  ],
  "paths": {
    "/health": { "get": { "tags": ["doctor"], "summary": "Basic health check", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
    "/ready": { "get": { "tags": ["doctor"], "summary": "Public readiness check", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
    "/system/login/options": { "get": { "tags": ["auth"], "summary": "Login options, captcha policy, and public OAuth providers", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
    "/system/login/captcha": { "get": { "tags": ["auth"], "summary": "Captcha SVG", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
    "/system/login": { "post": { "tags": ["auth"], "summary": "Password login", "security": [], "responses": { "200": { "$ref": "#/components/responses/OK" }, "400": { "$ref": "#/components/responses/OK" } } } },
    "/system/logout": { "post": { "tags": ["auth"], "summary": "Logout current token", "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
    "/system/info": { "get": { "tags": ["auth"], "summary": "Current user, permissions, menus, data scope, and mustChangePassword", "responses": { "200": { "$ref": "#/components/responses/OK" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/system/menu": { "get": { "tags": ["auth"], "summary": "Current user menu tree", "responses": { "200": { "$ref": "#/components/responses/OK" } } } },
